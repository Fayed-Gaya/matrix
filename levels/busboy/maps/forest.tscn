[node name="Waykeeper" type="Marker2D" parent="NPCs"]
position = Vector2(320, 400)
metadata/dialogue = "The roots have closed the old path. That pale light can loosen them.
But what you draw from the forest clings to you.

Strike: no stain. Cleanse: stronger, but the roots strike harder.
Guard to recover mana and shed a little stain. Watch their next move."
